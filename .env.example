# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of THIS app (no trailing slash). Used to build the magic
# links in the daily email. On Vercel, set it to your production domain.
APP_URL=http://localhost:3000

# Random 32+ char string. Signs the author magic-link tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Random string. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Password for the /admin dashboard.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Only needed locally, to run `npm run db:migrate`.
SUPABASE_DB_PASSWORD=
# Optional override -- use the Session pooler string if you have no IPv6 route.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Anthropic (story curation + article drafting)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Two stages, two models. Curation runs every day over a long candidate list
# and dominates the bill; drafting only runs when an author commissions a piece
# and is the actual product. Defaults below cost roughly $0.12 per daily run.
# CURATION_MODEL=claude-sonnet-5
# WRITING_MODEL=claude-opus-5
# ANTHROPIC_MODEL=            # sets both at once, if you want one knob

# Cheaper still: CURATION_EFFORT=low, or CURATION_MODEL=claude-haiku-4-5
# CURATION_EFFORT=medium
# WRITING_EFFORT=high

# Characters of source text sent per candidate -- the main input-cost lever.
# CURATION_TEXT_BUDGET=1800

# ---------------------------------------------------------------------------
# WordPress
# ---------------------------------------------------------------------------
WP_URL=https://mediadrumworld.com
WP_USERNAME=
# Application Password from WP Admin -> Users -> Profile -> Application Passwords.
# Spaces are fine; they are stripped automatically.
WP_APP_PASSWORD=
# Status new posts are created with: draft | pending | publish
WP_DEFAULT_STATUS=draft

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be a verified sending domain in Resend.
EMAIL_FROM="MediaDrum Newsroom <newsroom@mediadrumworld.com>"
# Optional: BCC every brief here for oversight.
# EMAIL_BCC=editorial@mediadrumworld.com

# TEST MODE -- on unless explicitly set to false. Every email is redirected to
# EMAIL_TEST_RECIPIENT instead of the real author and stamped with who it was
# meant for, so a live run can be exercised without anyone else being emailed.
# With test mode on and no recipient set, nothing is sent at all.
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=

# ---------------------------------------------------------------------------
# Discovery tuning (all optional)
# ---------------------------------------------------------------------------
# How many stories go in the daily brief.
# SHORTLIST_SIZE=5
# How many pre-ranked candidates get their full text fetched for curation.
# DEEP_READ_COUNT=28
# Ignore anything older than this many hours.
# MAX_STORY_AGE_HOURS=72
