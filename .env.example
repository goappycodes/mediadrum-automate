# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of THIS app (no trailing slash). Used to build the magic
# links in the daily email. On Vercel, set it to your production domain.
APP_URL=http://localhost:3000

# Random 32+ char string. Signs the author magic-link tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Random string. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Password for the /admin dashboard.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Only needed locally, to run `npm run db:migrate`.
SUPABASE_DB_PASSWORD=
# Optional override -- use the Session pooler string if you have no IPv6 route.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Anthropic (story curation + article drafting)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5
# CURATION_EFFORT=high
# WRITING_EFFORT=high

# ---------------------------------------------------------------------------
# WordPress
# ---------------------------------------------------------------------------
WP_URL=https://mediadrumworld.com
WP_USERNAME=
# Application Password from WP Admin -> Users -> Profile -> Application Passwords.
# Spaces are fine; they are stripped automatically.
WP_APP_PASSWORD=
# Status new posts are created with: draft | pending | publish
WP_DEFAULT_STATUS=draft

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be a verified sending domain in Resend.
EMAIL_FROM="MediaDrum Newsroom <newsroom@mediadrumworld.com>"
# Optional: BCC every brief here for oversight.
# EMAIL_BCC=editorial@mediadrumworld.com

# ---------------------------------------------------------------------------
# Discovery tuning (all optional)
# ---------------------------------------------------------------------------
# How many stories go in the daily brief.
# SHORTLIST_SIZE=5
# How many pre-ranked candidates get their full text fetched for curation.
# DEEP_READ_COUNT=28
# Ignore anything older than this many hours.
# MAX_STORY_AGE_HOURS=72
