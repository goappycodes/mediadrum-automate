{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/discover",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/discover/route.ts": { "maxDuration": 300 },
    "src/app/api/submissions/route.ts": { "maxDuration": 300 },
    "src/app/api/submissions/[id]/generate/route.ts": { "maxDuration": 300 }
  }
}
